{
  "name": "@feature-forge/monorepo",
  "version": "0.3.1",
  "private": true,
  "description": "Pi extension for autonomous software engineering — structured discovery, ADR-driven design, and multi-agent implementation from idea to PR.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck:watch",
    "test:e2e": "vitest run --project cli-e2e",
    "flow:generate-schema": "npm -w @feature-forge/cli run flow:generate-schema",
    "flow:validate": "npm -w @feature-forge/cli run flow:validate",
    "flow:validate-json": "npm -w @feature-forge/cli run flow:validate-json",
    "check": "npm run lint && npm run format && npm run test",
    "fix": "npm run lint:fix && npm run format:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/cli/dist/index.js"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.79.10",
    "@earendil-works/pi-ai": "0.79.10",
    "@earendil-works/pi-coding-agent": "0.79.10",
    "@earendil-works/pi-tui": "0.79.10",
    "@types/node": "26.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "turbo": "^2.5.3",
    "typebox": "1.3.8",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "files": [
    "packages/cli/dist/index.js",
    "packages/cli/scripts/",
    "packages/cli/defaults/",
    "packages/cli/bin/"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "orchestrator",
    "autonomous",
    "software-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misiekhardcore/feature-forge.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/misiekhardcore/feature-forge#readme",
  "bugs": {
    "url": "https://github.com/misiekhardcore/feature-forge/issues"
  }
}
