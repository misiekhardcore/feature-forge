{
  "name": "@feature-forge/monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Pi extension for autonomous software engineering — structured discovery, ADR-driven design, and multi-agent implementation from idea to PR.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck:watch",
    "test:e2e": "vitest run --project cli-e2e",
    "flow:generate-schema": "pnpm -w @feature-forge/core run flow:generate-schema",
    "flow:validate": "pnpm -w @feature-forge/core run flow:validate",
    "flow:validate-json": "pnpm -w @feature-forge/core run flow:validate-json",
    "check": "pnpm run lint && pnpm run format && pnpm run test",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/cli/dist/index.js"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "@feature-forge/eslint-config": "workspace:*",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "turbo": "^2.11.11",
    "typebox": "1.4.7",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  },
  "files": [
    "packages/cli/dist/index.js",
    "packages/cli/scripts/",
    "packages/cli/bin/"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "orchestrator",
    "autonomous",
    "software-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misiekhardcore/feature-forge.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/misiekhardcore/feature-forge#readme",
  "bugs": {
    "url": "https://github.com/misiekhardcore/feature-forge/issues"
  }
}
