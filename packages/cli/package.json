{
  "name": "@feature-forge/cli",
  "version": "0.1.4",
  "description": "Pi extension for autonomous software engineering — structured discovery, ADR-driven design, and multi-agent implementation from idea to PR.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misiekhardcore/feature-forge.git"
  },
  "homepage": "https://github.com/misiekhardcore/feature-forge#readme",
  "bugs": {
    "url": "https://github.com/misiekhardcore/feature-forge/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "orchestrator",
    "autonomous",
    "software-engineering"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/",
    "scripts/",
    "defaults/",
    "bin/",
    "README.md"
  ],
  "main": "dist/index.js",
  "bin": {
    "forge": "bin/forge.js"
  },
  "scripts": {
    "build": "tsup && node --input-type=module -e \"import m from './dist/index.js'; if (typeof m !== 'function') process.exit(1)\"",
    "test": "echo 'cli: tests via vitest workspace'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test:watch": "vitest --watch",
    "test:e2e": "vitest run --project cli-e2e",
    "flow:generate-schema": "npx tsx scripts/generate-flow-schema.ts && npx prettier --write src/flows/flow-schema.json",
    "flow:validate": "npx tsx scripts/validate-flow.ts",
    "flow:validate-json": "npx tsx scripts/validate-flow-json.ts",
    "changelog": "git-cliff -o CHANGELOG.md"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@feature-forge/shared": "*",
    "@feature-forge/tui": "*",
    "@feature-forge/debug": "*",
    "tsup": "^8.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typebox": "1.3.0",
    "@feature-forge/eslint-config": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
