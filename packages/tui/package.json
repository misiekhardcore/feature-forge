{
  "name": "@feature-forge/tui",
  "version": "0.3.1",
  "private": true,
  "description": "Terminal user interface components for feature-forge",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "echo 'tui: nothing to build'",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
